// **************************************
// t000006

t000006::
t000006 () :
  tester("t000006", 
         "Tests the parser for g_infixed_arithmetic grammar with the "
         "text '15 - 9', and a routine associated to the  term "
         "and the factor production") {}

t000006::
~t000006() {}

class t000006::r_term : public routine {

public:

  r_term() :
    routine(routine_id("r_term")) {}

  
  ptr<symbol> exec(symbols::iterator first,
                   symbols::iterator last) const {

    cerr << "r_term: begin report\n";
    for (symbols::iterator i = first;
         i != last;
         ++i) {
      cerr << (*i)->get_id() << "\n";
    }
    cerr << "r_term: end report:\n";

    return (ptr<symbol>());
  }
};

class t000006::r_factor : public routine {

public:

  r_factor() :
    routine(routine_id("r_factor")) {}

  
  ptr<symbol> exec(symbols::iterator first,
                   symbols::iterator last) const {

    cerr << "++++++++++++++++++++++++++" << endl;
    cerr << "r_factor: begin report\n";
    for (symbols::iterator i = first;
         i != last;
         ++i) {
      cerr << (*i)->get_id() << "\n";
    }

    // we know the only possible values are '15' or '9'
    ptr<symbol> rc;
    cerr << "(last -1) - first = " << distance(last,first) << endl;

    switch (distance(last,first)) {
    case 2:
      // we know this is '15'
      rc = *first;
      break;
    case 4:
      // we know the arithmetic is '15 - 9'
      rc = new symbol (symbol_id("135"), type_id("reserved_symbol_type"));
      break;
    default:
      rc = new symbol (symbol_id("HELP"), type_id("reserved_symbol_type"));
    }

    cerr << "r_factor: end report\n";
    return rc;
  }
};

constant 
t000006::
exec (ptr<print_tester_log> prt_tester_log) {
  constant rc = result::success;


  try {

    parser<g_infixed_arithmetic> p;

    ptr<r_factor> f (new r_factor());
    p.add_routine (f);

    ptr<r_term> t (new r_term());
    p.add_routine (t);

    p.set_routine(production_id("infixed_arithmetic"), 
                  item_id(2),
                  routine_id("r_term"));

    p.set_routine(production_id("term"), 
                  item_id(0),
                  routine_id("r_factor"));
    
    string input ("15 * 9");

    p.run(input);
  }
  catch (tenacitas::interpreter::exception e) {
    rc = e.error_code;
    print_ex(e, prt_tester_log);
  }
  catch (tenacitas::basic::exception e) {
    rc = e.error_code;
    prt_tester_log->print(e);
  }
  return rc;
}

