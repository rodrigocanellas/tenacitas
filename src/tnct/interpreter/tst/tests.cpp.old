#include "tests.h"


void print_ex(tenacitas::interpreter::exception &e,
              ptr<print_tester_log> prt_tester_log) {


  ostringstream s;

  s << "class '" << e.class_name << "', ";
  s << "method '" << e.method_name << "', ";
  s << "error " << e.error_code << ", ";
  ptr<translator> trans = prt_tester_log-> get_translator();
  string translation = trans->translate(e.class_name, e.error_code);
  s << "error text '" << translation << "', ";
  s << "symbol read '" << e.symbol_read << "', ";
  s << "line " << e.line << ", ";
  s << "column " << e.column << "\n";


  prt_tester_log->print(s.str());
}


// **************************************
// t000000

t000000::
t000000 () :
  tester("t000000", 
         "Tests the parser for g_infixed_arithmetic grammar "
         "with the text '3'") {}

t000000::
~t000000() {}

constant 
t000000::
exec (ptr<print_tester_log> prt_tester_log) {
  constant rc = result::success;


  try {

    parser<g_infixed_arithmetic> p;

    string input ("3");

    p.run(input);
  }
  catch (tenacitas::interpreter::exception e) {
    rc = e.error_code;
    print_ex(e, prt_tester_log);
  }
  catch (tenacitas::basic::exception e) {
    rc = e.error_code;
    prt_tester_log->print(e);
  }
  return rc;
}

