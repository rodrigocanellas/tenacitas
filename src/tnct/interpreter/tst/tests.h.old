void print_ex(tenacitas::interpreter::exception &e,
              ptr<print_tester_log> prt_tester_log);


* Tests the parser for \p g_infixed_arithmetic grammar with the text '3'
class t000000 : public tester {

 public:
  t000000 ();
  ~t000000();
  constant exec (ptr<print_tester_log> prt_tester_log);
  

};

* Tests the parser for \p g_infixed_arithmetic grammar with the text '- 9'
class t000001 : public tester {

 public:
  t000001 ();
  ~t000001();
  constant exec (ptr<print_tester_log> prt_tester_log);
};

